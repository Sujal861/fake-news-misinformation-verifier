{
  // Local development + preview config for the Cloudflare Worker.
  // `wrangler dev` serves public/ as static assets and routes /api/* to the Worker.
  "name": "forward-check",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Leave empty locally to exercise the offline heuristic-only path.
    "FACTCHECK_API_KEY": "",
    "EXA_API_KEY": "",
    "LLM_API_KEY": "",
    "LLM_BASE_URL": "https://api.openai.com/v1",
    "LLM_MODEL": "gpt-4o-mini",
    // Chat channels. Declared so the names are discoverable; set the real
    // values with `wrangler secret put`, which overrides an empty var here.
    // An unset channel refuses every webhook instead of answering.
    "TELEGRAM_BOT_TOKEN": "",
    "TELEGRAM_WEBHOOK_SECRET": "",
    "WHATSAPP_TOKEN": "",
    "WHATSAPP_PHONE_NUMBER_ID": "",
    "WHATSAPP_APP_SECRET": "",
    "WHATSAPP_VERIFY_TOKEN": "",
    // Bump if Meta retires this Graph API version.
    "WHATSAPP_API_VERSION": "v26.0"
  }
}
